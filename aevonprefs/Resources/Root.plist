<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Aevon</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Aevon 分屏</string>
			<key>footerText</key>
			<string>V0.0.3 最小浮窗版（纯 arm64e / roothide）。用法：打开「启用插件」并注销；把目标 App 切到后台（留在多任务卡片）长按该卡片即可窗口化，也可长按主屏图标选「Open in Window」。所有功能只在本页开关，无需终端/SSH。日志文件：/var/mobile/PullOverMF.log（Filza 可见，出错请先看它）。若 SpringBoard 反复异常，插件会自动禁用，可在本页重新开启。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用插件</string>
			<key>key</key>
			<string>Enabled</string>
			<key>defaults</key>
			<string>com.aevon.tweak</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>窗口保活（保持前台）</string>
			<key>key</key>
			<string>KeepAlive</string>
			<key>defaults</key>
			<string>com.aevon.tweak</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>安全与日志</string>
			<key>footerText</key>
			<string>「开机崩溃保护」：每次加载写入 loading 状态，SpringBoard 稳定 20 秒后标记 healthy；若下次启动发现上次仍是 loading，则自动禁用插件，阻断崩溃死循环。「写日志文件」关闭后仍保留系统日志（Console.app 可查）。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>开机崩溃保护</string>
			<key>key</key>
			<string>CrashGuard</string>
			<key>defaults</key>
			<string>com.aevon.tweak</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>写日志文件（/var/mobile/PullOverMF.log）</string>
			<key>key</key>
			<string>LogEnabled</string>
			<key>defaults</key>
			<string>com.aevon.tweak</string>
			<key>default</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
