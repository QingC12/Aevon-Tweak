<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!--
		  V0.2.1（AevonAppWhitelistV200 沿用）：仍然只列两个 App。

		  0.2.0 只读探针在 Aevon(87) 日志里证明了「App 进程加载 + 读 com.Aevon 域」
		  两件为真；0.2.1 在这两个 App 上做真接管（delaysTouchesBegan +
		  cancelsTouchesInView），验证「圆盘出来了、App 不再跟着动」。
		  0.2.2 再放开到 Classes=[UIApplication] + 运行时白名单（带银行/游戏排除）。
		  扩白名单之前，任何一环出问题都只影响设置和 Safari，随时可在设置里关掉
		  「App 进程右缘接管」回到纯只读。
		-->
		<key>Bundles</key>
		<array>
			<string>com.apple.Preferences</string>
			<string>com.apple.mobilesafari</string>
		</array>
	</dict>
</dict>
</plist>
