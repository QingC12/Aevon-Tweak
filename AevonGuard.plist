<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.w3.org/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!--
		  V0.0.35 (AevonGuardUIKitV35): 必须注入所有 GUI App, Aevon(28) 定论。
		  旧写法 Mode=Any + 空 Filter 在 roothide 的 ellekit 注入器上可能被整个跳过
		  (Aevon(28) 日志: 0.0.34 加的 Guard 注入日志一条都没有, 圆盘期触摸照进抖音)。
		  改用经典全 App 写法: 所有 GUI 进程都链接 UIKit framework (bundle
		  com.apple.UIKit), loader 按链接库匹配即可稳定注入。
		  构造函数仍有三重保险: SpringBoard / 无 UIApplication / 设置 App 直接 return。
		-->
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
		</array>
	</dict>
</dict>
</plist>
