<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Aevon 分屏</string>
			<key>footerText</key>
			<string>Aevon 0.1.15（arm64e / roothide）。用法：打开「启用插件」→ 注销 → 在设定的热区内向左滑呼出圆盘 → 点图标开浮窗；桌面上只会有一个浮窗，再点别的 App 会直接换成它。顶边双击恢复默认大小与位置。从桌面点图标把浮窗里的 App 全屏打开时，浮窗会自动关闭（不再残留黑窗）。0.1.15 起：全屏 App 内有两个稳入口 —— 右下角热区（48×320），以及屏幕右缘的接管带（默认宽 28pt、覆盖下半 60% 高度），两处都是「按下即接管、向左滑 ≥30pt 呼出」，App 全程收不到触摸、绝不会被带起来。代价写在「右缘接管带」开关下面：带内 App 自己的轻点 / 右滑也归我们，嫌碍事可以关掉或把宽度、高度调小。日志：/var/mobile/Aevon.log。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>启用插件</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>EdgeGestureEnabled</string>
			<key>label</key>
			<string>边缘左滑呼出圆盘（热区 + 全屏 App 右缘）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>RightEdgeTakeover</string>
			<key>label</key>
			<string>右缘接管带（0.1.15 默认开）：全屏 App 内，屏幕右缘一条带按下即接管，向左滑 30pt 呼出圆盘，App 连 began 都收不到，所以绝不会跟着动。代价：这条带里 App 自己的轻点 / 右滑 / 贴边滚动也归我们（这是「整指接管」的物理代价，不是 bug）。宽度与高度在「细节调整」里调</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>BandTakeoverFromBegan</string>
			<key>label</key>
			<string>右缘全域接管（旧机制，默认关）：把接管带扩到右缘 44pt × 整屏高，连上半屏也能呼出。一般不用开 —— 上面那条带已经覆盖下半屏；只有你要在屏幕上半部右缘呼出时才打开</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>TouchEnabled</string>
			<key>label</key>
			<string>浮窗内可直接触摸操作（关掉=内容不接收触摸，防止点穿到下面的 App。窗口拖动 / 关闭 / 缩放照常，改动立即生效）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>SwitcherLongPress</string>
			<key>label</key>
			<string>多任务卡片长按开窗（实验）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>CrashGuard</string>
			<key>label</key>
			<string>开机崩溃保护</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>LogEnabled</string>
			<key>label</key>
			<string>写日志文件（/var/mobile/Aevon.log）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>ProbeV107</string>
			<key>label</key>
			<string>运行时探针（排错用，每次启动跑一轮六组）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>细节调整</string>
			<key>footerText</key>
			<string>触发条位置 / 宽度 / 高度、圆盘 App 编辑等细节调整都在二级页（AevonDetailPageV30）。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>触发条 / 圆盘细节调整</string>
			<key>action</key>
			<string>aevonOpenDetail</string>
		</dict>
	</array>
	<key>title</key>
	<string>Aevon</string>
</dict>
</plist>
