			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>ProbeV107</string>
			<key>label</key>
			<string>运行时探针（排错用，每次启动跑一轮六组）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>细节调整</string>
			<key>footerText</key>
			<string>触发条位置 / 宽度 / 高度、圆盘 App 编辑等细节调整都在二级页（AevonDetailPageV30）。</string>
		</dict>
