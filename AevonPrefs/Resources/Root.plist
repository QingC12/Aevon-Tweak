			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>SwitcherLongPress</string>
			<key>label</key>
			<string>多任务卡片长按开窗（实验）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>CrashGuard</string>
			<key>label</key>
			<string>开机崩溃保护</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.Aevon</string>
			<key>key</key>
			<string>LogEnabled</string>
			<key>label</key>
			<string>写日志文件（/var/mobile/Aevon.log）</string>
		</dict>
		<dict>
